# ── App ────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
API_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
# extra comma-separated origins allowed by CORS (optional)
CORS_ORIGINS=

# ── Database ───────────────────────────────────────────
MONGO_URI=mongodb://127.0.0.1:27017/avron_cms

# ── Auth ───────────────────────────────────────────────
# generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING_MIN_32_CHARS
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=30
REFRESH_COOKIE_NAME=avron_rt
BCRYPT_ROUNDS=12

# ── Redis (optional — app runs without it) ─────────────
REDIS_URL=

# ── Cloudinary ─────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_BASE_FOLDER=avron

# ── SMTP bootstrap fallback (runtime SMTP lives in Settings) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Avron Studio
SMTP_FROM_EMAIL=no-reply@avron.local

# ── Seeder ─────────────────────────────────────────────
SEED_SUPERADMIN_NAME=Super Admin
SEED_SUPERADMIN_EMAIL=admin@avron.local
SEED_SUPERADMIN_PASSWORD=Admin@12345
